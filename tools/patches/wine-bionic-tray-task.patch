+/* Snapshot and semantic operations are served by the icon registry owner.
+ * Clients neither inspect Explorer internals nor synthesize icon-window input. */
+static void tray_pixels( HICON image, BYTE *pixels )
+{
+    BITMAPINFO info = {{sizeof(BITMAPINFOHEADER), ARLINUX_TRAY_ICON_SIZE, -ARLINUX_TRAY_ICON_SIZE,
+                       1, 32, BI_RGB}};
+    DWORD *bits, *mask, alpha = 0;
+    HDC dc = CreateCompatibleDC( 0 ), mask_dc = CreateCompatibleDC( 0 );
+    HBITMAP dib = CreateDIBSection( dc, &info, DIB_RGB_COLORS, (void **)&bits, 0, 0 );
+    HBITMAP mask_dib = CreateDIBSection( mask_dc, &info, DIB_RGB_COLORS, (void **)&mask, 0, 0 );
+    HGDIOBJ old, mask_old;
+    unsigned int i;
+    if (!dc || !mask_dc || !dib || !mask_dib) goto done;
+    old = SelectObject( dc, dib ); mask_old = SelectObject( mask_dc, mask_dib );
+    memset( bits, 0, sizeof(((struct arlinux_tray_item *)0)->pixels) );
+    memset( mask, 0xff, sizeof(((struct arlinux_tray_item *)0)->pixels) );
+    DrawIconEx( dc, 0, 0, image, ARLINUX_TRAY_ICON_SIZE, ARLINUX_TRAY_ICON_SIZE, 0, 0, DI_NORMAL );
+    DrawIconEx( mask_dc, 0, 0, image, ARLINUX_TRAY_ICON_SIZE, ARLINUX_TRAY_ICON_SIZE, 0, 0, DI_MASK );
+    for (i = 0; i < ARLINUX_TRAY_ICON_SIZE * ARLINUX_TRAY_ICON_SIZE; ++i) alpha |= bits[i] >> 24;
+    for (i = 0; i < ARLINUX_TRAY_ICON_SIZE * ARLINUX_TRAY_ICON_SIZE; ++i)
+    {
+        DWORD value = bits[i];
+        unsigned int a = alpha ? value >> 24 : ((mask[i] & 0xffffff) ? 0 : 255);
+        /* DrawIconEx uses premultiplied BGRA; the shell consumes straight RGBA. */
+        pixels[4*i]   = a ? min( 255, ((value >> 16) & 255) * 255 / a ) : 0;
+        pixels[4*i+1] = a ? min( 255, ((value >> 8) & 255) * 255 / a ) : 0;
+        pixels[4*i+2] = a ? min( 255, (value & 255) * 255 / a ) : 0;
+        pixels[4*i+3] = a;
+    }
+    SelectObject( dc, old ); SelectObject( mask_dc, mask_old );
+done:
+    if (dib) DeleteObject( dib );
+    if (mask_dib) DeleteObject( mask_dib );
+    if (dc) DeleteDC( dc );
+    if (mask_dc) DeleteDC( mask_dc );
+}
+
+static BOOL tray_bridge( HWND client, const COPYDATASTRUCT *copy )
+{
+    struct arlinux_tray_request request;
+    struct arlinux_tray_reply *reply;
+    struct arlinux_tray_item *items;
+    struct icon *icon;
+    COPYDATASTRUCT response;
+    WCHAR cls[64];
+    DWORD count = 0;
+    DWORD_PTR result;
+    size_t size;
+    if (copy->cbData != sizeof(request) || !copy->lpData ||
+        !GetClassNameW( client, cls, ARRAY_SIZE(cls) ) || lstrcmpW( cls, ARLINUX_TRAY_CLIENT )) return FALSE;
+    memcpy( &request, copy->lpData, sizeof(request) );
+    if (request.version != ARLINUX_TRAY_PROTOCOL || request.reserved ||
+        request.operation < ARLINUX_TRAY_LIST || request.operation > ARLINUX_TRAY_MENU) return FALSE;
+    if (request.operation == ARLINUX_TRAY_LIST)
+        LIST_FOR_EACH_ENTRY( icon, &icon_list, struct icon, entry )
+            if (!(icon->state & NIS_HIDDEN) && IsWindow( icon->owner )) ++count;
+    if (count > ARLINUX_TRAY_MAX_ICONS) return FALSE;
+    size = sizeof(*reply) + count * sizeof(*items);
+    if (!(reply = calloc( 1, size ))) return FALSE;
+    reply->version = ARLINUX_TRAY_PROTOCOL;
+    reply->process = GetCurrentProcessId();
+    items = (struct arlinux_tray_item *)(reply + 1);
+    if (request.operation == ARLINUX_TRAY_LIST)
+    {
+        LIST_FOR_EACH_ENTRY( icon, &icon_list, struct icon, entry )
+        {
+            if ((icon->state & NIS_HIDDEN) || !IsWindow( icon->owner )) continue;
+            items[reply->count].token = icon->token;
+            lstrcpynW( items[reply->count].title, icon->tiptext, ARRAY_SIZE(icon->tiptext) );
+            tray_pixels( icon->image, items[reply->count].pixels );
+            ++reply->count;
+        }
+        reply->success = TRUE;
+    }
+    else if (request.process == GetCurrentProcessId())
+    {
+        LIST_FOR_EACH_ENTRY( icon, &icon_list, struct icon, entry )
+        {
+            WPARAM wp;
+            LPARAM lp;
+            UINT message;
+            if (icon->token != request.token || (icon->state & NIS_HIDDEN) || !IsWindow( icon->owner )) continue;
+            SetCursorPos( request.x, request.y );
+            if (request.operation == ARLINUX_TRAY_MENU)
+            {
+                SetForegroundWindow( icon->owner );
+                wp = icon->version >= NOTIFYICON_VERSION_4 ? MAKEWPARAM( request.x, request.y ) : icon->id;
+                lp = icon->version >= NOTIFYICON_VERSION_4 ? MAKELPARAM( WM_RBUTTONDOWN, icon->id ) : WM_RBUTTONDOWN;
+                SendNotifyMessageW( icon->owner, icon->callback_message, wp, lp );
+            }
+            message = request.operation == ARLINUX_TRAY_MENU ?
+                (icon->version >= NOTIFYICON_VERSION_4 ? WM_CONTEXTMENU : WM_RBUTTONUP) :
+                WM_LBUTTONDBLCLK;
+            wp = icon->id; lp = message;
+            if (icon->version >= NOTIFYICON_VERSION_4)
+            {
+                wp = MAKEWPARAM( request.x, request.y );
+                lp = MAKELPARAM( message, icon->id );
+            }
+            reply->success = SendNotifyMessageW( icon->owner, icon->callback_message, wp, lp );
+            if (reply->success && request.operation == ARLINUX_TRAY_OPEN)
+            {
+                lp = icon->version >= NOTIFYICON_VERSION_4 ? MAKELPARAM( WM_LBUTTONUP, icon->id ) : WM_LBUTTONUP;
+                reply->success = SendNotifyMessageW( icon->owner, icon->callback_message, wp, lp );
+            }
+            break;
+        }
+    }
+    response.dwData = ARLINUX_TRAY_COPYDATA;
+    response.cbData = size;
+    response.lpData = reply;
+    result = 0;
+    SendMessageTimeoutW( client, WM_COPYDATA, (WPARAM)tray_window, (LPARAM)&response,
+                         SMTO_ABORTIFHUNG, 2000, &result );
+    free( reply );
+    return result != 0;
+}
