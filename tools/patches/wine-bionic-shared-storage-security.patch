+/* Android shared storage uses synthetic ownership. Project only access which
+ * the host actually grants to this application, retaining the real owner SID. */
+struct security_descriptor *default_fd_sd( int fd, mode_t mode, uid_t uid )
+{
+    struct security_descriptor *sd = mode_to_sd( mode, security_unix_uid_to_sid( uid ),
+                                                token_get_primary_group( current->process->token ));
+#ifdef __ANDROID__
+    struct statfs fs;
+    struct security_descriptor *expanded;
+    struct acl *dacl;
+    struct ace *ace;
+    const struct sid *user = security_unix_uid_to_sid( getuid() );
+    char path[64];
+    unsigned int access = 0;
+    int access_flags = getuid() == geteuid() ? 0 : AT_EACCESS;
+    size_t extra = sizeof(*ace) + sid_len( user );
+
+    /* FUSE and sdcardfs ownership/mode bits do not describe scoped-storage grants. */
+    if (!sd || uid == getuid() || fstatfs( fd, &fs ) ||
+        (fs.f_type != 0x65735546 && fs.f_type != 0x5dca2df5)) return sd;
+    snprintf( path, sizeof(path), "/proc/self/fd/%d", fd );
+    if (!faccessat( AT_FDCWD, path, R_OK, access_flags )) access |= FILE_GENERIC_READ;
+    if (!faccessat( AT_FDCWD, path, W_OK, access_flags )) access |= FILE_GENERIC_WRITE;
+    if (!faccessat( AT_FDCWD, path, X_OK, access_flags )) access |= FILE_GENERIC_EXECUTE;
+    if (!access) return sd;
+    expanded = realloc( sd, sizeof(*sd) + sd->owner_len + sd->group_len + sd->dacl_len + extra );
+    if (!expanded) return sd;
+    sd = expanded;
+    dacl = (struct acl *)((char *)(sd + 1) + sd->owner_len + sd->group_len);
+    ace = (struct ace *)((char *)dacl + dacl->size);
+    set_ace( ace, user, ACCESS_ALLOWED_ACE_TYPE,
+             (mode & S_IFDIR) ? OBJECT_INHERIT_ACE | CONTAINER_INHERIT_ACE : 0, access );
+    sd->dacl_len += extra;
+    dacl->size += extra;
+    dacl->count++;
+#endif
+    return sd;
+}
