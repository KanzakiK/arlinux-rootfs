From: ARLinux developers
Subject: ole32: reject revoking drag targets belonging to another process

The OleDropTargetInterface property contains an address in the registering
process and WineMarshalledDropTarget contains its mapping handle. Neither may
be consumed directly in another process. Apply the same ownership boundary
already used by RegisterDragDrop before reading either property.

--- a/dlls/ole32/ole2.c
+++ b/dlls/ole32/ole2.c
@@ -631,6 +631,7 @@ HRESULT WINAPI RevokeDragDrop(HWND hwnd)
   IStream *stream;
   IDropTarget *drop_target;
   HRESULT hr;
+  DWORD pid = 0;
 
   TRACE("(%p)\n", hwnd);
 
@@ -640,6 +641,11 @@ HRESULT WINAPI RevokeDragDrop(HWND hwnd)
     return DRAGDROP_E_INVALIDHWND;
   }
 
+  /* Both the interface pointer and mapping handle belong to the owner. */
+  GetWindowThreadProcessId(hwnd, &pid);
+  if (pid != GetCurrentProcessId())
+    return RPC_E_WRONG_THREAD;
+
   /* no registration data */
   if (!(map = get_droptarget_handle(hwnd)))
     return DRAGDROP_E_NOTREGISTERED;
