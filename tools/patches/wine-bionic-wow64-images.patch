+/* Host-import memory can lack HOST_COHERENT on Mali. Preserve the application
+ * contract by flushing before submission and invalidating after successful
+ * host synchronization, rather than advertising an unusable memory type. */
+static VkResult sync_coherent_memory( struct vulkan_device *device, BOOL invalidate )
+{
+    struct device_memory *memory;
+    VkResult result = VK_SUCCESS;
+    pthread_mutex_lock( &coherent_guard );
+    for (memory = coherent_memory; memory; memory = memory->coherent_next)
+    {
+        VkMappedMemoryRange range = {.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE};
+        if (memory->owner != device->client.device) continue;
+        range.memory = memory->obj.host.device_memory;
+        range.size = VK_WHOLE_SIZE;
+        if (invalidate) result = device->p_vkInvalidateMappedMemoryRanges( device->host.device, 1, &range );
+        else result = device->p_vkFlushMappedMemoryRanges( device->host.device, 1, &range );
+        if (result) break;
+    }
+    pthread_mutex_unlock( &coherent_guard );
+    return result;
 }
 
