+/* Images rejected with the implicit WOW64 host-import flag can still live
+ * in ordinary dedicated memory. Never import a CPU pointer for those
+ * allocations; retain the normal WOW64 mapping checks if a caller maps one. */
+struct device_only_image
+{
+    VkDevice device;
+    VkImage image;
+    struct device_only_image *next;
+};
+static pthread_mutex_t device_only_guard = PTHREAD_MUTEX_INITIALIZER;
+static struct device_only_image *device_only_images;
+
+static void forget_device_only_image( VkDevice device, VkImage image )
+{
+    struct device_only_image **entry, *old;
+    pthread_mutex_lock( &device_only_guard );
+    for (entry = &device_only_images; *entry;)
+    {
+        if ((*entry)->device != device || (image && (*entry)->image != image))
+        { entry = &(*entry)->next; continue; }
+        old = *entry; *entry = old->next; free( old );
+    }
+    pthread_mutex_unlock( &device_only_guard );
+}
+
+static BOOL is_device_only_image( VkDevice device, VkImage image )
+{
+    struct device_only_image *entry;
+    BOOL found = FALSE;
+    pthread_mutex_lock( &device_only_guard );
+    for (entry = device_only_images; entry; entry = entry->next)
+        if (entry->device == device && entry->image == image) { found = TRUE; break; }
+    pthread_mutex_unlock( &device_only_guard );
+    return found;
+}
+
+static void require_device_only_dedicated( VkDevice device, VkImage image, VkMemoryRequirements2 *requirements )
+{
+    VkBaseOutStructure *next;
+    if (!is_device_only_image( device, image )) return;
+    for (next = requirements->pNext; next; next = next->pNext)
+        if (next->sType == VK_STRUCTURE_TYPE_MEMORY_DEDICATED_REQUIREMENTS)
+        {
+            VkMemoryDedicatedRequirements *dedicated = (void *)next;
+            dedicated->requiresDedicatedAllocation = VK_TRUE;
+            dedicated->prefersDedicatedAllocation = VK_TRUE;
+        }
+}
