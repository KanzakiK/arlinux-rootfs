Subject: [PATCH] winex11: clear unpainted transparent GDI windows

Use an ARGB visual for software-drawn WS_EX_TRANSPARENT windows before
first paint. Ordinary GDI flushes retain opaque alpha. Exclude direct
drawing and layered windows, which manage their own visuals. Expose events
request deferred painting instead of publishing an unpainted white surface.

--- a/dlls/winex11.drv/bitblt.c
+++ b/dlls/winex11.drv/bitblt.c
@@ -2024,6 +2024,13 @@
         data->layered = TRUE;
         if (!data->embedded && argb_visual.visualid) set_window_visual( data, &argb_visual, TRUE );
     }
+    else if (argb_visual.visualid && !enable_direct_drawing( data, FALSE ) &&
+             (NtUserGetWindowLongW( hwnd, GWL_EXSTYLE ) & (WS_EX_TRANSPARENT | WS_EX_LAYERED)) == WS_EX_TRANSPARENT)
+    {
+        /* Leave an unpainted transparent window clear. GDI flushes still force
+         * opaque alpha, until UpdateLayeredWindow supplies per-pixel alpha. */
+        set_window_visual( data, &argb_visual, FALSE );
+    }
     if ((previous = *surface) && previous->funcs == &x11drv_surface_funcs)
     {
         Window window = get_x11_surface(previous)->window;
--- a/dlls/winex11.drv/event.c
+++ b/dlls/winex11.drv/event.c
@@ -839,6 +839,7 @@
     POINT pos;
     struct x11drv_win_data *data;
     UINT flags = RDW_INVALIDATE | RDW_FRAME | RDW_ALLCHILDREN;
+    BOOL transparent;
 
     TRACE( "win %p (%lx) %d,%d %dx%d\n",
            hwnd, event->window, event->x, event->y, event->width, event->height );
@@ -876,9 +877,15 @@
     }
     else flags &= ~RDW_ALLCHILDREN;
 
+    transparent = event->window != root_window && data->surface &&
+                  data->vis.visualid == argb_visual.visualid && !data->use_alpha &&
+                  (NtUserGetWindowLongW( hwnd, GWL_EXSTYLE ) & (WS_EX_TRANSPARENT | WS_EX_LAYERED)) == WS_EX_TRANSPARENT;
     release_win_data( data );
 
-    NtUserExposeWindowSurface( hwnd, flags, &rect );
+    /* A transparent GDI window must paint after the windows below it. Blitting
+     * an exposed but unpainted surface publishes its initial white pixels. */
+    if (transparent) NtUserRedrawWindow( hwnd, &rect, NULL, flags );
+    else NtUserExposeWindowSurface( hwnd, flags, &rect );
     return TRUE;
 }
 
