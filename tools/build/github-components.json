{
  "format": 1,
  "workflow": "arlinux-component.yml",
  "workspace": "/opt/arlinux",
  "cacheLimitGiB": 10,
  "products": {
    "capture": "vulkan-capture",
    "rootfs": "yibu",
    "debian": "debian",
    "arch": "arch",
    "omarchy": "omarchy",
    "plasma": "plasma",
    "lxqt": "lxqt"
  },
  "stages": {
    "vulkan-capture": {
      "repository": "taowen/gfxreconstruct",
      "runner": "ubuntu-24.04-arm",
      "dependencies": [],
      "product": "capture",
      "compilerCacheMiB": 2048
    },
    "yibu": {
      "repository": "taowen/arlinux-yibu",
      "runner": "ubuntu-24.04-arm",
      "dependencies": [
        "linux-mesa",
        "linux-hybris",
        "vulkan-capture"
      ],
      "product": "rootfs",
      "compilerCacheMiB": 2048
    },
    "debian": {
      "repository": "taowen/arlinux-debian",
      "runner": "ubuntu-24.04-arm",
      "dependencies": [
        "linux-mesa",
